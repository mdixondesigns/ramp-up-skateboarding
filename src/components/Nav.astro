---
const aboutLinks = [
  { href: "/about/history", label: "Ramp Up History" },
  { href: "/about/team", label: "The Team" },
  { href: "/about/philosophy", label: "Our Philosophy" },
];

const programLinks = [
  { href: "/programs/free-clinics", label: "Free Clinics" },
  { href: "/programs/calendar", label: "Calendar" },
  { href: "/programs/seasonal-sessions", label: "Seasonal Sessions" },
  { href: "/programs/private-lessons", label: "Private Lessons" },
];

const getInvolvedLinks = [
  { href: "/get-involved/coach-with-us", label: "Coach With Us" },
  { href: "/get-involved/partner-with-ramp-up", label: "Partner With Ramp Up" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark">Ramp Up</a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      Menu
    </button>

    <nav id="primary-nav" class="primary-nav">
      <div class="nav-item has-dropdown">
        <a href="/about">About</a>
        <ul class="dropdown">
          {aboutLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="nav-item has-dropdown">
        <a href="/programs">Programs</a>
        <ul class="dropdown">
          {programLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="nav-item">
        <a href="/parent-resources">Parent Resources</a>
      </div>

      <div class="nav-item has-dropdown">
        <a href="/get-involved">Get Involved</a>
        <ul class="dropdown">
          {getInvolvedLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="nav-item">
        <a href="/contact">Contact</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .wordmark {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.4rem 0.75rem;
    font: inherit;
    cursor: pointer;
  }

  .primary-nav {
    display: flex;
    gap: 1.75rem;
  }

  .nav-item {
    position: relative;
  }

  .nav-item > a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    margin: 0.5rem 0 0;
    padding: 0.5rem 0;
    list-style: none;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    min-width: 200px;
    z-index: 10;
  }

  .dropdown li a {
    display: block;
    padding: 0.4rem 1rem;
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .dropdown li a:hover {
    background: var(--bg-alt);
  }

  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    display: block;
  }

  @media (max-width: 720px) {
    .nav-toggle {
      display: inline-block;
    }

    .primary-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 0.5rem 1.5rem 1rem;
    }

    .primary-nav.open {
      display: flex;
    }

    .nav-item {
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--border);
    }

    .dropdown {
      display: block;
      position: static;
      border: none;
      padding: 0.25rem 0 0;
    }

    .site-header {
      position: relative;
    }
  }
</style>

<script>
  const toggle = document.querySelector(".nav-toggle");
  const nav = document.getElementById("primary-nav");

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>
