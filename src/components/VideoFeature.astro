---
import PatternOverlay from "./PatternOverlay.astro";

/**
 * A featured video beside a short pitch for it.
 *
 * The player is not embedded on load. A YouTube iframe pulls several hundred
 * kilobytes of script and sets cookies before anyone has decided to watch, so
 * what ships is a poster and a play button; the iframe replaces it on click.
 * That is the whole reason this component owns a script at all.
 */
interface Props {
  /** The YouTube video id, e.g. the `eaulmma259M` in a watch?v= URL. */
  videoId: string;
  /** Used as the iframe title and the play button's accessible name. */
  videoTitle: string;
  eyebrow?: string;
  heading: string;
  body?: string;
  cta?: { label: string; href: string };
  /** Overrides the poster. Defaults to YouTube's own thumbnail for the video. */
  posterUrl?: string;
  /** `left` puts the copy first; `right` puts the video first. */
  mediaSide?: "left" | "right";
}

const {
  videoId,
  videoTitle,
  eyebrow,
  heading,
  body,
  cta,
  posterUrl,
  mediaSide = "right",
} = Astro.props;

const poster = posterUrl ?? `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;

// nocookie is the same player without the tracking cookie on first play.
const embedSrc = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
---

<section class="inset video-section">
  <div class:list={["band on-dark", `band--media-${mediaSide}`]}>
    <PatternOverlay
      pattern="tile"
      opacity={0.28}
      mask="radial-gradient(120% 110% at 100% 0%, #000 10%, transparent 60%)"
    />

    <div class="grid">
      <div class="text">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2>{heading}</h2>
        {body && <p class="body">{body}</p>}
        {
          cta && (
            <a class="button button--primary button--sm" href={cta.href}>
              {cta.label}
            </a>
          )
        }
      </div>

      <div class="player" data-video={embedSrc} data-title={videoTitle}>
        <img src={poster} alt="" loading="lazy" width="1280" height="720" />
        <button type="button" class="play" data-play>
          <span class="visually-hidden">Play video: {videoTitle}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .video-section {
    margin-bottom: var(--section-y);
  }

  .band {
    position: relative;
    background: var(--ink);
    border-radius: var(--r-block);
    padding: 72px var(--gutter);
    overflow: hidden;
  }

  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 56px;
    align-items: center;
  }

  .band--media-left .text {
    grid-column: 2;
    grid-row: 1;
  }

  .band--media-left .player {
    grid-column: 1;
    grid-row: 1;
  }

  .text h2 {
    font-size: var(--step-h2-section);
    margin: 0 0 16px;
  }

  .body {
    font-size: 18px;
    margin: 0 0 28px;
  }

  /* The frame is the aspect ratio; the poster and the iframe both fill it. */
  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-photo);
    overflow: hidden;
    background: var(--ink-deep);
  }

  .player img,
  .player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border: 0;
    padding: 0;
    background: rgba(35, 32, 30, 0.28);
    color: var(--ink);
    cursor: pointer;
    transition: background var(--dur) var(--ease);
  }

  .play:hover {
    background: rgba(35, 32, 30, 0.12);
  }

  .play svg {
    width: 34px;
    height: 34px;
    /* The yellow disc behind the glyph — one element instead of two. */
    box-sizing: content-box;
    padding: 22px 20px 22px 24px;
    background: var(--yellow);
    border-radius: 50%;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
    transition: transform var(--dur) var(--ease);
  }

  .play:hover svg {
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .play svg {
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    /* One column: copy first, whichever side it was asked to sit on. */
    .band--media-left .text,
    .band--media-left .player {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>

<script>
  /*
   * Swaps the poster for the real player on click. Scoped per component
   * instance, so more than one video on a page each behave independently.
   */
  for (const player of document.querySelectorAll<HTMLElement>("[data-video]")) {
    const button = player.querySelector<HTMLButtonElement>("[data-play]");

    button?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = player.dataset.video ?? "";
      iframe.title = player.dataset.title ?? "Video";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";

      player.replaceChildren(iframe);
      iframe.focus();
    });
  }
</script>
