---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  guide: CollectionEntry<"guides">;
  /** 190px on the index grid, 180px in "Read next". */
  imageHeight?: number;
  /** "Read next" cards drop the reading-time link. */
  compact?: boolean;
}

const { guide, imageHeight = 190, compact = false } = Astro.props;
const { title, excerpt, heroImage, heroAlt, readingTime } = guide.data;
---

<a class="card guide-card" href={`/parent-resources/${guide.id}`}>
  <Image
    src={heroImage}
    alt={heroAlt}
    width={520}
    densities={[1, 2]}
    style={`height: ${imageHeight}px;`}
  />

  <div class="body">
    <h3>{title}</h3>
    <p class="excerpt">{excerpt}</p>
    {!compact && <span class="link-underline read-time">{readingTime} min read</span>}
  </div>
</a>

<style>
  .guide-card :global(img) {
    width: 100%;
    object-fit: cover;
  }

  .body {
    padding: 24px 28px 28px;
  }

  h3 {
    font-size: 23px;
    font-weight: 700;
    line-height: 1.18;
    margin: 0 0 10px;
  }

  .excerpt {
    font-size: 16px;
    color: var(--ink-70);
    margin: 0 0 16px;
  }

  .read-time {
    font-size: 15px;
  }
</style>
