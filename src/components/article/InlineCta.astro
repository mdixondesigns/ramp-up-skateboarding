---
interface Props {
  heading: string;
  body: string;
  href: string;
  label: string;
}

const { heading, body, href, label } = Astro.props;
---

<aside class="inline-cta on-yellow">
  <div class="copy">
    <h3>{heading}</h3>
    <p>{body}</p>
  </div>
  <a href={href} class="button button--ink button--sm">{label}</a>
</aside>

<style>
  .inline-cta {
    display: flex;
    gap: 22px;
    align-items: center;
    background: var(--yellow);
    border-radius: 30px;
    padding: 32px 38px;
    margin: 44px 0 0;
  }

  .copy {
    flex: 1;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.6875rem);
    margin: 0 0 6px;
  }

  p {
    font-size: 17px;
    margin: 0;
  }

  .button {
    flex: none;
  }

  @media (max-width: 640px) {
    .inline-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: 28px 26px;
    }
  }
</style>
