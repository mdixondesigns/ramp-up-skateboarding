---
import PlyStripe from "../PlyStripe.astro";

/**
 * White card pairing short colored labels with descriptions — used in guides
 * for things like deck sizing by age.
 *
 * Rows come from the `rows` prop rather than a slot so the label/description
 * pairing stays a two-column grid at every width.
 */
interface Props {
  title: string;
  rows: { label: string; body: string; color?: string }[];
}

const { title, rows } = Astro.props;

// Cycle the AA-compliant category colors so labels stay readable on white.
const labelColors = [
  "var(--cat-getting-started)",
  "var(--cat-safety-gear)",
  "var(--cat-keeping-it-going)",
  "var(--cat-at-the-clinic)",
];
---

<div class="spec-card">
  <PlyStripe variant="d" height={12} bleed={34} gap={28} />
  <h3>{title}</h3>

  <div class="rows">
    {
      rows.map((row, i) => (
        <div class="row">
          <span class="label" style={`color: ${row.color ?? labelColors[i % labelColors.length]};`}>
            {row.label}
          </span>
          <span class="body">{row.body}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .spec-card {
    background: var(--white);
    border-radius: var(--r-card);
    padding: 0 34px 32px;
    margin: 0 0 32px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  h3 {
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 18px;
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 18px;
    align-items: baseline;
  }

  .label {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
  }

  .body {
    font-size: 17px;
    color: var(--ink-70);
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
