---
import PatternOverlay from "../PatternOverlay.astro";
---

<blockquote class="pull-quote on-dark">
  <PatternOverlay
    pattern="tile"
    opacity={0.3}
    mask="radial-gradient(120% 110% at 100% 100%, #000 10%, transparent 66%)"
  />
  <p><slot /></p>
</blockquote>

<style>
  .pull-quote {
    position: relative;
    background: var(--ink);
    border-radius: 32px;
    padding: 40px 44px;
    margin: 0 0 34px;
    overflow: hidden;
  }

  .pull-quote p {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 1.6875rem);
    line-height: 1.28;
    margin: 0;
    color: var(--cream);
  }
</style>
