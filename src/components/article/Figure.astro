---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="figure">
  <div class="frame">
    <Image src={src} alt={alt} width={760} densities={[1, 2]} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 0 0 34px;
  }

  .frame {
    border-radius: var(--r-card);
    overflow: hidden;
    margin-bottom: 14px;
  }

  .frame :global(img) {
    width: 100%;
    height: 320px;
    object-fit: cover;
  }

  figcaption {
    font-size: 15px;
    color: var(--ink-55);
    margin: 0;
  }
</style>
