---
import { Image } from "astro:assets";
import logo from "../assets/brand/ramp-up-logo.png";
import { primaryNav } from "../data/navigation";

// Mark the active section from the current URL so /programs/calendar still
// highlights "Programs".
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo-chip" aria-label="Ramp Up — home">
      <Image src={logo} alt="Ramp Up" height={50} densities={[1, 2]} />
    </a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Menu"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      {
        primaryNav.map((link) => (
          <a
            href={link.href}
            class:list={["nav-link", { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a href="/#join" class="header-cta">Get clinic dates by email</a>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    background: var(--paper);
    border-bottom: 1px solid var(--rule-light);
  }

  .header-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 16px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .logo-chip {
    background: var(--ink);
    border-radius: 18px;
    padding: 10px 18px;
    display: flex;
    align-items: center;
    flex: none;
  }

  .logo-chip :global(img) {
    height: 50px;
    width: auto;
  }

  .primary-nav {
    display: flex;
    gap: 6px;
    font-size: 15px;
    font-weight: 700;
  }

  .nav-link {
    padding: 9px 16px;
    border-radius: var(--r-pill);
    white-space: nowrap;
    transition: background var(--dur) var(--ease);
  }

  .nav-link:hover {
    background: rgba(46, 42, 40, 0.06);
  }

  .nav-link.active {
    background: var(--ink);
    color: var(--paper);
  }

  .header-cta {
    background: var(--yellow);
    color: var(--ink);
    font-weight: 700;
    font-size: 15px;
    padding: 13px 24px;
    border-radius: var(--r-pill);
    white-space: nowrap;
    flex: none;
    transition: background var(--dur) var(--ease);
  }

  .header-cta:hover {
    background: #e2a92f;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 10px;
    background: none;
    border: 1px solid var(--rule-light-strong);
    border-radius: 12px;
    cursor: pointer;
  }

  .bar {
    display: block;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }

  /*
   * Under ~980px the nav collapses, but the yellow CTA stays in the bar —
   * it's the site's primary conversion action.
   */
  @media (max-width: 980px) {
    .nav-toggle {
      display: flex;
      order: 3;
    }

    .header-cta {
      order: 2;
    }

    .primary-nav {
      order: 4;
      display: none;
      flex-direction: column;
      gap: 2px;
      width: 100%;
      padding-top: 12px;
    }

    .primary-nav.open {
      display: flex;
    }

    .header-inner {
      flex-wrap: wrap;
    }

    .nav-link {
      padding: 12px 16px;
    }
  }

  /* Keep the logo, CTA, and toggle on one row rather than wrapping. */
  @media (max-width: 480px) {
    .header-inner {
      gap: 10px;
      padding-inline: 16px;
    }

    .header-cta {
      font-size: 13px;
      padding: 10px 14px;
    }

    .nav-toggle {
      width: 42px;
      height: 42px;
      padding: 0 9px;
    }

    .logo-chip {
      padding: 8px 12px;
      border-radius: 14px;
    }

    .logo-chip :global(img) {
      height: 36px;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.getElementById("primary-nav");

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>
