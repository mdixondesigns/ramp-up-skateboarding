---
/**
 * The colored, textured band across the top edge of a card.
 *
 * Relies on negative horizontal margins inside an `overflow: hidden` card, so
 * the parent card must supply its horizontal padding via the `bleed` prop.
 */
interface Props {
  color: string;
  texture: "dots" | "hatch" | "arcs" | "checker";
  height?: number;
  /** The parent card's horizontal padding, cancelled so the cap bleeds. */
  bleed?: number;
  class?: string;
}

const {
  color,
  texture,
  height = 78,
  bleed = 34,
  class: className,
} = Astro.props;
---

<div
  class:list={["cap", `cap--${texture}`, className]}
  style={`--cap-color: ${color}; --cap-height: ${height}px; --cap-bleed: ${bleed}px;`}
>
  <slot />
</div>

<style>
  .cap {
    position: relative;
    height: var(--cap-height);
    margin-inline: calc(var(--cap-bleed) * -1);
    background-color: var(--cap-color);
  }

  .cap--dots {
    background-image: radial-gradient(rgba(46, 42, 40, 0.16) 2px, transparent 2px);
    background-size: 14px 14px;
  }

  .cap--hatch {
    background-image: repeating-linear-gradient(
      135deg,
      rgba(46, 42, 40, 0.14) 0 6px,
      transparent 6px 14px
    );
  }

  .cap--arcs {
    background-image: repeating-radial-gradient(
      circle at 50% 165%,
      transparent 0 16px,
      rgba(46, 42, 40, 0.16) 16px 19px
    );
  }

  .cap--checker {
    background-image: linear-gradient(
      45deg,
      rgba(46, 42, 40, 0.14) 25%,
      transparent 25%,
      transparent 75%,
      rgba(46, 42, 40, 0.14) 75%
    );
    background-size: 18px 18px;
  }
</style>
