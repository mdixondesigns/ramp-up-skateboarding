---
import TestimonialCard from "./TestimonialCard.astro";
import { featuredTestimonials } from "../data/testimonials";

interface Props {
  heading?: string;
  /** Hide the Google reviews pill where it would be redundant. */
  showReviewsLink?: boolean;
}

const { heading = "What parents are saying", showReviewsLink = true } = Astro.props;

const featured = featuredTestimonials();

// TODO(Christine): replace with the real Google Business profile URL.
const googleReviewsUrl =
  "https://www.google.com/maps/search/?api=1&query=Ramp+Up+Skateboarding";
---

<section class="testimonials band-bleed on-dark">
  <div class="dot-grid" aria-hidden="true"></div>

  <div class="container testimonials-inner">
    <h2 class="testimonials-head">{heading}</h2>

    <div class="grid grid--3">
      {featured.map((testimonial) => <TestimonialCard testimonial={testimonial} />)}
    </div>

    {
      showReviewsLink && (
        <p class="reviews-link-wrap">
          <a
            class="reviews-link"
            href={googleReviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="stars" aria-hidden="true">
              &#9733;&#9733;&#9733;&#9733;&#9733;
            </span>
            <span>Read all our 5-star reviews on Google</span>
            <span class="arrow" aria-hidden="true">
              &#8599;
            </span>
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .testimonials {
    position: relative;
    background: var(--ink-deep);
    padding-block: var(--section-y);
    overflow: hidden;
  }

  .dot-grid {
    position: absolute;
    inset: 0;
    opacity: 0.14;
    background-image: radial-gradient(var(--yellow) 2px, transparent 2px);
    background-size: 22px 22px;
  }

  .testimonials-inner {
    position: relative;
  }

  .testimonials-head {
    font-size: var(--step-h2-section);
    margin: 0 0 40px;
    text-align: center;
  }

  .reviews-link-wrap {
    text-align: center;
    margin: 44px 0 0;
  }

  .reviews-link {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    background: var(--paper);
    color: var(--ink);
    border-radius: var(--r-pill);
    padding: 15px 32px;
    font-weight: 700;
    font-size: 17px;
    transition: transform var(--dur) var(--ease);
  }

  .reviews-link:hover {
    transform: translateY(-2px);
  }

  .stars {
    display: flex;
    gap: 3px;
    color: var(--star);
    font-size: 21px;
    line-height: 1;
  }

  .arrow {
    font-size: 19px;
    color: var(--ink-50);
  }

  @media (max-width: 560px) {
    .reviews-link {
      flex-direction: column;
      gap: 8px;
      text-align: center;
      padding: 20px 28px;
    }
  }
</style>
