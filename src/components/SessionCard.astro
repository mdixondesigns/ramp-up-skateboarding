---
import { Image } from "astro:assets";

/**
 * One paid, multi-week session on the Seasonal Sessions page.
 *
 * Registration lives on Sawyer, so the button is a plain outbound link rather
 * than an embed — these are managed by hand, a few at a time, and an embedded
 * widget per session would be far more machinery than the page needs.
 */
interface Props {
  name: string;
  location: string;
  ages: string;
  blurb: string;
  image: ImageMetadata;
  imageAlt: string;
  /** The session's Sawyer listing. Without one the card says so plainly. */
  registerUrl?: string;
}

const { name, location, ages, blurb, image, imageAlt, registerUrl } = Astro.props;
---

<article class="card session">
  <Image src={image} alt={imageAlt} width={520} densities={[1, 2]} class="thumb" />

  <div class="body">
    <p class="location">{location}</p>
    <h3>{name}</h3>
    <p class="ages">{ages}</p>
    <p class="blurb">{blurb}</p>

    {
      registerUrl ? (
        <a class="button button--primary button--sm register" href={registerUrl}>
          Register
        </a>
      ) : (
        <span class="pending">Registration opens soon</span>
      )
    }
  </div>
</article>

<style>
  /*
   * A column, so the register button can be pushed to the bottom edge and line
   * up across cards whose blurbs run to different lengths.
   */
  .session {
    display: flex;
    flex-direction: column;
  }

  .session :global(.thumb) {
    width: 100%;
    height: 190px;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px 28px 28px;
  }

  .location {
    align-self: start;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-70);
    border: 2px solid var(--rule-light-strong);
    border-radius: var(--r-pill);
    padding: 6px 14px;
    margin: 0 0 16px;
  }

  h3 {
    font-size: 23px;
    font-weight: 700;
    line-height: 1.18;
    margin: 0 0 8px;
  }

  .ages {
    font-size: 15px;
    color: var(--ink-55);
    margin: 0 0 12px;
  }

  .blurb {
    font-size: 16px;
    color: var(--ink-70);
    margin: 0 0 24px;
  }

  /* Sits against the card's bottom padding however tall the blurb runs. */
  .register,
  .pending {
    align-self: start;
    margin-top: auto;
  }

  .pending {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink-55);
    border: 2px dashed var(--rule-light-strong);
    border-radius: var(--r-pill);
    padding: 14px 26px;
  }
</style>
