---
import { Image } from "astro:assets";
import { partners } from "../data/partners";
---

<section class="section partners">
  <div class="container">
    <p class="eyebrow centered">
      Schools, boroughs, rec centers and local partners we've worked with
    </p>

    <ul class="tiles">
      {
        partners.map((partner) => (
          <li class:list={["tile", { "tile--dark": partner.dark }]}>
            <Image
              src={partner.logo}
              alt={partner.name}
              height={partner.maxHeight * 2}
              densities={[1, 2]}
              style={`max-height: ${partner.maxHeight}px;`}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .partners {
    padding-block: 76px;
  }

  .centered {
    text-align: center;
    margin-bottom: 28px;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tile {
    height: 116px;
    border-radius: var(--r-tile);
    background: var(--white);
    border: 1px solid var(--rule-tile);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px 22px;
  }

  /* For white-on-transparent logos, which vanish on a white tile. */
  .tile--dark {
    background: var(--ink);
  }

  .tile :global(img) {
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  @media (max-width: 980px) {
    .tiles {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 560px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }

    .tile {
      height: 96px;
    }
  }
</style>
