---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<!--
  TODO(Christine): generate this widget from your Sawyer for Business
  portal (My Account > Settings > Self-Embed Widgets) and paste the embed
  code here in place of this placeholder div. Docs:
  https://help.hisawyer.com/en/articles/11105549-self-embed-widgets
