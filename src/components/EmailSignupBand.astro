---
/**
 * The yellow "Join the movement" block. Appears at the foot of every designed
 * page; only the heading and body change.
 */
interface Props {
  heading?: string;
  body?: string;
  id?: string;
}

const {
  heading = "Join the movement",
  body = "Free clinic dates go out by email first, and they fill fast.",
  id = "join",
} = Astro.props;
---

<section class="inset band-inset">
  <div class="band on-yellow" id={id}>
    <div class="dots" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>

    <h2>{heading}</h2>
    <p class="band-body">{body}</p>

    {/*
      Posts straight to MailerLite. The target is a hidden iframe rather than a
      new tab, so the subscriber is added for real while the page keeps its own
      success state and its own styling. Field names are MailerLite's and must
      not be renamed. The account and form ids are public embed identifiers,
      not secrets.

      Known limitation: an iframe post is fire-and-forget, so we cannot read
      MailerLite's response. A rejected address still shows the success state.
    */}
    <iframe name={`${id}-ml-sink`} class="visually-hidden" tabindex="-1" title="" aria-hidden="true"
    ></iframe>

    <form
      class="signup"
      data-signup
      novalidate
      method="post"
      action="https://assets.mailerlite.com/jsonp/410130/forms/85997053135554229/subscribe"
      target={`${id}-ml-sink`}
    >
      <label class="visually-hidden" for={`${id}-email`}>Email address</label>
      <input
        id={`${id}-email`}
        type="email"
        name="fields[email]"
        placeholder="you@email.com"
        autocomplete="email"
        required
      />
      <input type="hidden" name="ml-submit" value="1" />
      <input type="hidden" name="anticsrf" value="true" />
      <button type="submit">Sign up</button>
    </form>

    <p class="success" data-signup-success hidden role="status">
      You're on the list. We'll email you as soon as the next dates go up.
    </p>
    <p class="error" data-signup-error hidden role="alert">
      That doesn't look like an email address. Mind checking it?
    </p>

    <p class="fine-print">We never share your address. Unsubscribe any time.</p>
  </div>
</section>

<style>
  .band {
    background: var(--yellow);
    color: var(--ink);
    border-radius: var(--r-block);
    padding: 76px var(--gutter);
    text-align: center;
    margin-bottom: var(--section-y);
  }

  .dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 22px;
  }

  .dots span {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--ink);
  }

  h2 {
    font-size: var(--step-h2);
    line-height: 1.04;
    margin: 0 0 14px;
  }

  .band-body {
    font-size: 19px;
    margin: 0 auto 34px;
    max-width: 54ch;
  }

  .signup {
    display: flex;
    gap: 12px;
    max-width: 580px;
    margin: 0 auto;
  }

  .signup input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 17px;
    padding: 19px 26px;
    border: none;
    border-radius: var(--r-pill);
    background: var(--white);
    color: var(--ink);
  }

  .signup button {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 17px;
    padding: 19px 34px;
    border: none;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    transition: background var(--dur) var(--ease);
  }

  .signup button:hover {
    background: #413b38;
  }

  .success,
  .error {
    font-size: 18px;
    font-weight: 700;
    margin: 0 auto;
    max-width: 580px;
  }

  .error {
    font-weight: 600;
    margin-top: 12px;
  }

  .fine-print {
    font-size: 15px;
    margin: 16px 0 0;
    opacity: 0.8;
  }

  @media (max-width: 560px) {
    .band {
      padding: 52px var(--gutter);
    }

    .signup {
      flex-direction: column;
    }
  }
</style>

<script>
  /*
   * Validate, then let the submit through. The form posts to MailerLite with a
   * hidden iframe as its target, so the browser never navigates and we can show
   * our own success state in place of the form.
   */
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-signup]")) {
    const band = form.parentElement;
    const success = band?.querySelector<HTMLElement>("[data-signup-success]");
    const error = band?.querySelector<HTMLElement>("[data-signup-error]");
    const input = form.querySelector<HTMLInputElement>("input[type=email]");

    form.addEventListener("submit", (event) => {
      if (!input?.checkValidity() || !input.value.includes("@")) {
        // Only block the submit when the address is obviously wrong.
        event.preventDefault();
        error?.removeAttribute("hidden");
        input?.focus();
        return;
      }

      // Valid: do NOT preventDefault. The post goes to the hidden iframe.
      error?.setAttribute("hidden", "");
      form.setAttribute("hidden", "");
      success?.removeAttribute("hidden");
    });

    input?.addEventListener("input", () => error?.setAttribute("hidden", ""));
  }
</script>
