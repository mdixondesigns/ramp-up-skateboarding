---
/**
 * A skate wheel: a colored ring with a transparent centre. Used as list
 * bullets, the location badge icon, calendar row markers, and download icons.
 *
 * The ring is a border, not a filled circle with a second circle on top, so
 * whatever sits behind shows through the hub. That matters because these land
 * on white cards, ink blocks, and translucent pills over photography — a
 * faked hub would have to know its backdrop, and would be wrong the moment
 * the backdrop changed.
 */
interface Props {
  /** Ring color. Brand hues only — this is a shape, never text. */
  color?: string;
  size?: number;
  class?: string;
}

const { color = "var(--cyan)", size = 42, class: className } = Astro.props;

// Keeps the hub at roughly a third of the wheel, matching the design at every
// size it's used (22px, 42px and 52px).
const ring = Math.round(size * 0.32);
---

<span
  class:list={["wheel", className]}
  aria-hidden="true"
  style={`--wheel-size: ${size}px; --wheel-color: ${color}; --wheel-ring: ${ring}px;`}
></span>

<style>
  .wheel {
    display: block;
    box-sizing: border-box;
    width: var(--wheel-size);
    height: var(--wheel-size);
    border: var(--wheel-ring) solid var(--wheel-color);
    border-radius: 50%;
    background: transparent;
    flex: none;
  }
</style>
