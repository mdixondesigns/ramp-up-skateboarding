---
import Layout from "../../layouts/Layout.astro";
import SawyerEmbed from "../../components/SawyerEmbed.astro";

// TODO(Christine): edit this list directly each season — add/remove entries
// as sessions open and close. This is the "Fall 2026, etc." content.
const currentSessions = [
  {
    name: "Fall 2026 Skate Club",
    location: "Lancaster Rec Center",
    ages: "Ages 6-12",
    blurb: "A multi-week progression session for kids ready to go beyond a single clinic.",
  },
];
---

<Layout
  title="Seasonal Sessions"
  description="Multi-week skateboarding sessions for kids ready to progress beyond a free clinic."
>
  <section>
    <div class="container">
      <p class="eyebrow">Programs &rsaquo; Seasonal Sessions</p>
      <h1>The next step after a free clinic.</h1>
      <p class="lede">
        A real progression over a season &mdash; for kids who tried a free
        clinic and want more.
      </p>

      <div class="grid cols-2">
        {currentSessions.map((session) => (
          <div class="card">
            <p class="tag">{session.location}</p>
            <h3>{session.name}</h3>
            <p class="muted">{session.ages}</p>
            <p>{session.blurb}</p>
          </div>
        ))}
      </div>

      <h2>Register</h2>
      <SawyerEmbed label="Seasonal session registration" />
    </div>
  </section>
</Layout>

<style>
  .muted {
    color: var(--muted);
  }
</style>
