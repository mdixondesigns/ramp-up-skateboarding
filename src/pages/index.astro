---
/**
 * Hub home: rampupskateboarding.com.
 *
 * STRUCTURE ONLY. Every [bracketed] line is a placeholder for copy that has
 * not been written yet. Do not launch with brackets showing.
 *
 * The five themes below are the ones Christine named when the site was
 * restructured into a hub (see docs/kb/pages.md). Their descriptions are
 * still to be written.
 *
 * The old home page, which was all about Lancaster free clinics, now lives at
 * src/pages/lancaster/index.astro.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailSignupBand from "../components/EmailSignupBand.astro";

const themes = [
  "Beginners first",
  "Kids and families",
  "Inclusivity",
  "Safety",
  "Wellness and mental health",
];

const sections = [
  {
    href: "/parent-resources",
    label: "Parent Resources",
    blurb: "Guides for parents of kids who want to learn to skateboard.",
  },
  {
    href: "/about",
    label: "About Ramp Up",
    blurb: "Who we are, where we came from, and what we believe.",
  },
  {
    href: "/updates",
    label: "Updates",
    blurb: "News about where Ramp Up is going.",
  },
  {
    href: "/get-involved",
    label: "Get Involved",
    blurb: "Coach with us, or bring Ramp Up to your community.",
  },
  {
    href: "/lancaster",
    label: "Lancaster Programs",
    blurb: "Free clinics and multi-week programs in the Lancaster, PA area.",
  },
];
---

<BaseLayout title="Ramp Up Skateboarding" description="[Hub meta description to come]">
  <section>
    <div class="container">
      <p class="eyebrow">Ramp Up Skateboarding</p>
      <h1>[Hub headline to come]</h1>
      <p class="lede">[One or two sentences on what Ramp Up stands for.]</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>What we stand for</h2>
      <div class="grid cols-3">
        {themes.map((theme) => (
          <div class="card">
            <h3>{theme}</h3>
            <p>[Copy to come]</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Explore</h2>
      <div class="grid cols-3">
        {sections.map((link) => (
          <a class="card link-card" href={link.href}>
            <h3>{link.label}</h3>
            <p>{link.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <EmailSignupBand heading="[Signup heading to come]" body="[What hub subscribers will get, to come]" />
</BaseLayout>

<style>
  .card h3 {
    margin-bottom: 0.5rem;
  }

  .card p {
    color: var(--ink-70);
    margin: 0;
  }

  .link-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }
</style>
