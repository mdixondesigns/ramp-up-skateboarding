---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TestimonialsSection from "../../../components/TestimonialsSection.astro";
import SawyerEmbed from "../../../components/SawyerEmbed.astro";
import EmailSignupBand from "../../../components/EmailSignupBand.astro";
---

<BaseLayout
  title="Free Learn to Skate Clinics"
  description="Join a free Learn to Skate clinic with Ramp Up. No experience needed and we bring the boards. Pre-registration required."
>
  <section>
    <div class="container">
      <p class="eyebrow">Programs &rsaquo; Free Clinics</p>
      <h1>No experience needed. Nothing to lose.</h1>
      <p class="lede">
        Our free Learn to Skate clinics are the easiest possible first yes.
        No experience, nothing to buy, no cost. Bring a helmet and we bring
        the rest.
      </p>

      <h2>What to expect</h2>
      <ul>
        <li>Boards are provided, sized for every kid. Bring a helmet and closed-toe shoes.</li>
        <li>A USSEA-certified lead coach runs every clinic, with one coach for every six kids.</li>
        <li>Pre-registration is required; space is limited.</li>
      </ul>

      <h2>Upcoming clinics</h2>
      <SawyerEmbed label="Free clinics list/calendar" />

      <p>
        {/*
          The `{" "}` is load-bearing: Astro drops the whitespace between an
          element and a text node that starts on the next line, so without it
          this reads "Join the movementto hear about".
        */}
        Not ready to commit yet? <a href="/lancaster#join">Join the movement</a>{" "}
        to hear about the next free clinic as soon as it's announced.
      </p>
    </div>
  </section>

  <TestimonialsSection heading="What first-timers are saying" />

  <EmailSignupBand />
</BaseLayout>
