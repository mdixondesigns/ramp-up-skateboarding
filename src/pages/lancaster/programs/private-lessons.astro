---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EmailSignupBand from "../../../components/EmailSignupBand.astro";
---

<BaseLayout
  title="Private Lessons"
  description="One-on-one skateboarding lessons with a USSEA-certified Ramp Up lead coach, for kids 6 to 14. Limited spots, by inquiry."
>
  <section>
    <div class="container">
      <p class="eyebrow">Programs &rsaquo; Private Lessons</p>
      <h1>The premium, one-on-one path.</h1>
      <p class="lede">
        One kid, one USSEA-certified lead coach, one hour. For ages 6 to 14.
      </p>
      <p>
        We offer a limited number of private lessons each year. Reach out
        using our <a href="/contact">contact page</a> to inquire about
        pricing and availability.
      </p>
      <p>
        <a class="button button--primary" href="/contact">Inquire about private lessons</a>
      </p>
    </div>
  </section>

  <EmailSignupBand
    heading="Not ready yet?"
    body="Join the movement and we'll let you know as new private lesson slots open up."
  />
</BaseLayout>
