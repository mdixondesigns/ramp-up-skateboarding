---
/**
 * Retired. Foundations and Intermediate replaced this page, and /programs is
 * now the live listing. Kept only as a redirect so old links, bookmarks and
 * search results land somewhere useful instead of a 404.
 *
 * If the host supports real 301s (Netlify _redirects, Vercel, Cloudflare),
 * move the rule there and delete this file. A meta refresh works everywhere,
 * but a server-side 301 passes link equity properly.
 */
const target = "/lancaster/programs";
const canonical = new URL(target, Astro.site ?? "https://rampupskateboarding.com").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Moved to Programs</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <p>This page has moved. <a href={target}>Go to Programs</a>.</p>
  </body>
</html>
