---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SessionCard from "../../../components/SessionCard.astro";
import EmailSignupBand from "../../../components/EmailSignupBand.astro";

import { openPrograms, hasOpenPrograms } from "../../../data/programs";

/*
 * This page is the live listing: whatever is open right now, with exact prices.
 * It gets edited every season, which is why the evergreen explanations of each
 * level live on their own pages. See docs/kb/pages.md.
 */

const levels = [
  {
    href: "/lancaster/programs/foundations",
    label: "Foundations",
    ages: "Ages 5 to 9",
    blurb:
      "The first paid step. Push, turn, stop, and roll down a ramp on purpose. Six weeks of building, one hour at a time.",
  },
  {
    href: "/lancaster/programs/intermediate",
    label: "Intermediate",
    ages: "Ages 6 to 12",
    blurb:
      "The next step up, where kids work toward the ollie. Most kids stay for a few seasons, and that's the plan.",
  },
];
---

<BaseLayout
  title="Programs"
  description="Free clinics, Foundations, and Intermediate skateboarding programs for kids across the Lancaster, PA area."
>
  <section>
    <div class="container">
      <p class="eyebrow">Programs</p>
      <h1>Most families start with a free clinic.</h1>
      <p class="lede">
        It costs nothing, it takes ninety minutes, and we bring the boards. If
        your kid loves it, Foundations is the next step.
      </p>

      <p>
        <a class="button button--primary" href="/lancaster/programs/free-clinics">
          See free clinic dates &rarr;
        </a>
      </p>

      <h2 id="open-now">Open for registration right now</h2>

      {
        hasOpenPrograms ? (
          <div class="grid grid--3 listings">
            {openPrograms.map((program) => (
              <SessionCard
                name={program.name}
                location={program.location}
                ages={program.ages}
                length={program.length}
                price={program.price}
                blurb={program.blurb}
                image={program.image}
                imageAlt={program.imageAlt}
                registerUrl={program.registerUrl}
              />
            ))}
          </div>
        ) : (
          <div class="card empty">
            <h3>Nothing open at the moment</h3>
            <p>
              Our season runs three quarters of the year, and new dates go out
              by email first. Tell us where you are and we'll let you know as
              soon as something opens near you.
            </p>
            <p>
              Want to keep practicing in the meantime? Hit up your local
              skatepark. We might see you there.
            </p>
            <p>
              <a class="button button--primary button--sm" href="#join">
                Get program dates by email
              </a>
            </p>
          </div>
        )
      }

      <h2 id="the-two-levels">The two levels</h2>
      <p>
        Every paid program is one of these. Each runs one hour a week, for 4 to
        8 weeks depending on the location.
      </p>

      <div class="grid cols-2">
        {
          levels.map((level) => (
            <a class="card link-card" href={level.href}>
              <h3>{level.label}</h3>
              <p class="level-ages">{level.ages}</p>
              <p>{level.blurb}</p>
            </a>
          ))
        }
      </div>

      <h2 id="one-on-one">One on one</h2>
      <p>
        We also run private lessons for kids aged 6 to 14. They work well for a
        kid who hung back in a group, or one moving faster than their class.
        <a class="link-underline" href="/lancaster/programs/private-lessons">Get in touch</a>
        and we'll sort out the details.
      </p>

      <p class="note">
        Scholarship spots and payment plans are sometimes available.
        <a class="link-underline" href="/contact">Just ask</a>, no forms.
      </p>
    </div>
  </section>

  <EmailSignupBand />
</BaseLayout>

<style>
  .listings {
    margin-top: 28px;
    align-items: start;
  }

  .empty {
    margin-top: 20px;
    max-width: 56ch;
  }

  .empty h3 {
    margin-bottom: 0.5rem;
  }

  .link-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .link-card h3 {
    margin-bottom: 0.25rem;
  }

  .level-ages {
    font-size: 15px;
    color: var(--ink-55);
    margin: 0 0 0.75rem;
  }

  .link-card p {
    color: var(--ink-70);
    margin: 0;
  }

  .note {
    font-size: 15px;
    color: var(--ink-50);
    margin: 32px 0 0;
  }
</style>
