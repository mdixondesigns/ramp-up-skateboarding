---
import { Image } from "astro:assets";

import BaseLayout from "../../layouts/BaseLayout.astro";
import PlyStripe from "../../components/PlyStripe.astro";
import PatternOverlay from "../../components/PatternOverlay.astro";
import WheelDot from "../../components/WheelDot.astro";
import CardCap from "../../components/CardCap.astro";
import GuideCard from "../../components/GuideCard.astro";
import EmailSignupBand from "../../components/EmailSignupBand.astro";

import { GUIDE_CATEGORIES } from "../../content.config";
import {
  getPublishedGuides,
  getFeaturedGuide,
  categorySlug,
} from "../../utils/guides";

const allGuides = await getPublishedGuides();
const featuredGuide = await getFeaturedGuide();
const otherGuides = allGuides.filter((g) => g.id !== featuredGuide?.id);

const quickAnswers = [
  {
    question: "What should they wear?",
    answer: "Closed-toe sneakers, long pants if you have them. That's the whole list.",
    color: "var(--cyan)",
    texture: "dots" as const,
  },
  {
    question: "Do we bring a board?",
    answer: "No. We bring 40 boards plus helmets and pads in every size, free to borrow.",
    color: "var(--pink)",
    texture: "hatch" as const,
  },
  {
    question: "Is it actually safe?",
    answer: "Helmets are required every session, and falling is the first skill we teach.",
    color: "var(--yellow)",
    texture: "arcs" as const,
  },
  {
    question: "Do I stay and watch?",
    answer: "Please do. Bring a chair, cheer loudly, and let the coaches do the coaching.",
    color: "var(--green)",
    texture: "checker" as const,
  },
];

// TODO(Christine): these need real PDFs. Drop them in public/downloads/ and
// give each row an `href` — they are deliberately not links until then.
const downloads = [
  {
    title: "Participant waiver",
    meta: "PDF · one page · one per child",
    color: "var(--cyan)",
  },
  {
    title: "Clinic day checklist",
    meta: "PDF · what to bring, what to skip",
    color: "var(--pink)",
  },
  {
    title: "Beginner gear shopping list",
    meta: "PDF · price ranges, no brand deals",
    color: "var(--yellow)",
  },
];

const faqs = [
  {
    question: "What does a clinic cost?",
    answer:
      "Our community clinics are free. Seasonal sessions and private lessons are paid, with scholarship spots in every session — just ask, no forms.",
  },
  {
    question: "What if it rains?",
    answer:
      "Wet ground means no session. We email and post by 7am the morning of, and you keep your spot for the makeup date.",
  },
  {
    question: "My kid has never been sporty.",
    answer:
      "Good. Skateboarding has no bench and no scoreboard. Kids progress at their own pace and nobody gets picked last.",
  },
  {
    question: "Can siblings share a spot?",
    answer:
      "Each child needs their own registration so we have the right gear sizes and coach ratio, but we always try to keep siblings in the same session.",
  },
  {
    question: "Are the coaches vetted?",
    answer:
      "Every coach is background-checked and certified, and there is never a session with a single adult on site.",
  },
  {
    question: "What if they hate it?",
    answer:
      "Then you spent a Saturday morning outside and it cost you nothing. Plenty of kids sit out half the first clinic and come back for the next one.",
  },
];
---

<BaseLayout
  title="Parent Resources"
  description="Short, honest answers about gear, safety, cost, and what happens after your kid catches the bug. Written by the coaches who run our clinics."
>
  {/* ------------------------------------------------------------- hero */}
  <section class="hero on-dark" id="top">
    <PatternOverlay
      pattern="blocks"
      opacity={0.42}
      mask="linear-gradient(255deg, #000 0%, #000 26%, transparent 62%)"
      parallax={0.25}
    />

    <div class="container hero-inner">
      <p class="eyebrow">Parent resources</p>
      <h1>Everything you were going to ask at drop-off</h1>
      <p class="hero-lede">
        Short, honest answers about gear, safety, cost, and what happens after
        your kid catches the bug. Written by the coaches who run our clinics.
      </p>
    </div>

    <PlyStripe variant="a" edge />
  </section>

  {/* ---------------------------------------------------- quick answers */}
  <section class="quick-answers">
    <div class="container">
      <h2 class="sub-head">Quick answers</h2>

      <div class="grid grid--4">
        {
          quickAnswers.map((item) => (
            <div class="card answer-card">
              <CardCap color={item.color} texture={item.texture} height={62} bleed={28} />
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* --------------------------------------------------- featured guide */}
  {
    featuredGuide && (
      <section class="inset featured-section">
        <a class="featured-card on-dark" href={`/parent-resources/${featuredGuide.id}`}>
          <Image
            src={featuredGuide.data.heroImage}
            alt={featuredGuide.data.heroAlt}
            widths={[720, 1280, 1920]}
            sizes="(max-width: 1280px) 100vw, 1200px"
            class="parallax-photo"
            data-parallax="0.5"
          />
          <div class="featured-scrim" aria-hidden="true" />

          <div class="featured-content">
            <span class="start-here">Start here</span>
            <h2>{featuredGuide.data.title}</h2>
            <p class="featured-body">{featuredGuide.data.excerpt}</p>
            <span class="button button--paper button--sm">Read the guide</span>
          </div>

          <PlyStripe variant="a" edge />
        </a>
      </section>
    )
  }

  {/* -------------------------------------------------------- all guides */}
  <section class="all-guides">
    <div class="container">
      <header class="guides-head">
        <h2 class="sub-head">All guides</h2>

        {/*
          Client-side filter over the pre-rendered grid — every card stays in
          the HTML, so this costs nothing for SEO and degrades to a plain
          full list if the script never runs.
        */}
        <div class="filters" role="group" aria-label="Filter guides by category">
          <button class="chip chip--active" data-filter="all" aria-pressed="true">All</button>
          {
            GUIDE_CATEGORIES.map((category) => (
              <button class="chip" data-filter={categorySlug(category)} aria-pressed="false">
                {category}
              </button>
            ))
          }
        </div>
      </header>

      <div class="grid grid--3" data-guide-grid>
        {otherGuides.map((guide) => <GuideCard guide={guide} />)}
      </div>

      <p class="no-results" data-no-results hidden>
        No guides in that category yet — more are on the way.
      </p>
    </div>
  </section>

  {/* --------------------------------------------------------- downloads */}
  <section class="inset">
    <div class="block-dark on-dark downloads">
      <PatternOverlay
        pattern="tile"
        opacity={0.36}
        mask="radial-gradient(130% 100% at 100% 100%, #000 12%, transparent 68%)"
      />

      <div class="downloads-grid">
        <div>
          <p class="eyebrow">Print and go</p>
          <h2>Paperwork, handled early</h2>
          <p class="downloads-body">
            Fill the waiver at home and check-in takes two minutes instead of ten.
          </p>
        </div>

        <ul class="download-list">
          {
            downloads.map((item) => (
              <li>
                <div class="row-dark download-row">
                  <WheelDot color={item.color} size={42} />
                  <span class="download-text">
                    <span class="download-title">{item.title}</span>
                    <span class="download-meta">{item.meta}</span>
                  </span>
                  <span class="download-icon" aria-hidden="true">
                    &#8595;
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="downloads-todo todo">
        TODO(Christine): these three rows need real PDFs before launch. Add them
        to <code>public/downloads/</code> and give each row an <code>href</code>
        in this page's frontmatter — they're intentionally not clickable yet so
        nobody lands on a 404.
      </p>
    </div>
  </section>

  {/* --------------------------------------------------------------- faq */}
  <section class="faq">
    <div class="container">
      <h2 class="faq-head">Still wondering</h2>
      <p class="faq-sub">The questions we get most often in the parking lot.</p>

      {/* An always-open grid, not an accordion — parents scan. */}
      <div class="faq-grid">
        {
          faqs.map((faq) => (
            <div class="faq-card">
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <EmailSignupBand
    heading="Still have a question?"
    body="Email us and a coach answers — usually the same day. Or get clinic dates in your inbox before they fill."
  />
</BaseLayout>

<style>
  /* ------------------------------------------------------------------ hero */
  .hero {
    position: relative;
    background: var(--ink);
    padding: 74px 0 82px;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    max-width: calc(700px + var(--gutter) * 2);
    margin-inline: 0;
  }

  .hero h1 {
    font-size: var(--step-hero-sm);
    line-height: 1.04;
    margin: 0 0 20px;
    color: var(--paper);
  }

  .hero-lede {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.55;
    color: var(--cream-dim);
    margin: 0;
    max-width: 46ch;
  }


  /* -------------------------------------------------------- shared heads */
  .sub-head {
    font-size: var(--step-h2-sub);
    margin: 0;
  }

  /* ------------------------------------------------------- quick answers */
  .quick-answers {
    padding: 64px 0 20px;
  }

  .quick-answers .sub-head {
    margin-bottom: 26px;
  }

  .answer-card {
    border-radius: var(--r-card-sm);
    padding: 0 28px 28px;
  }

  .answer-card h3 {
    font-size: 22px;
    font-weight: 700;
    margin: 24px 0 8px;
  }

  .answer-card p {
    font-size: 16px;
    color: var(--ink-70);
    margin: 0;
  }

  /* ------------------------------------------------------ featured guide */
  .featured-section {
    padding-top: 56px;
  }

  .featured-card {
    position: relative;
    display: block;
    height: 480px;
    border-radius: var(--r-photo);
    overflow: hidden;
    transition: transform var(--dur) var(--ease);
  }

  .featured-card:hover {
    transform: translateY(-2px);
  }

  .featured-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(35, 32, 30, 0.92) 0%,
      rgba(35, 32, 30, 0.62) 44%,
      rgba(35, 32, 30, 0) 74%
    );
  }

  .featured-content {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    width: min(540px, calc(100% - var(--gutter) * 2));
    color: var(--paper);
  }

  .start-here {
    display: inline-block;
    background: var(--yellow);
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 14px;
    border-radius: var(--r-pill);
    margin-bottom: 20px;
  }

  .featured-content h2 {
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.875rem);
    margin: 0 0 16px;
  }

  .featured-body {
    font-size: 19px;
    line-height: 1.55;
    color: var(--cream-dim);
    margin: 0 0 26px;
  }


  @media (max-width: 640px) {
    .featured-card {
      height: 440px;
    }

    .featured-scrim {
      background: linear-gradient(
        0deg,
        rgba(35, 32, 30, 0.94) 25%,
        rgba(35, 32, 30, 0.7) 65%,
        rgba(35, 32, 30, 0.3) 100%
      );
    }

    .featured-content {
      top: auto;
      bottom: 40px;
      transform: none;
    }

    .featured-body {
      font-size: 17px;
    }
  }

  /* ---------------------------------------------------------- all guides */
  .all-guides {
    padding: 64px 0 84px;
  }

  .guides-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
    flex-wrap: wrap;
  }

  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .chip {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: var(--r-pill);
    border: 2px solid var(--rule-light-strong);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .chip:hover {
    background: rgba(46, 42, 40, 0.06);
  }

  .chip--active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .no-results {
    font-size: 17px;
    color: var(--ink-70);
    margin: 24px 0 0;
  }

  /* ----------------------------------------------------------- downloads */
  .downloads {
    margin-bottom: var(--section-y);
    padding-block: 72px;
  }

  .downloads-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 56px;
    align-items: center;
  }

  .downloads-grid h2 {
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
    margin: 0 0 16px;
  }

  .downloads-body {
    font-size: 18px;
    margin: 0;
  }

  .download-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .download-text {
    flex: 1;
  }

  .download-title {
    display: block;
    font-size: 17px;
    font-weight: 700;
  }

  .download-meta {
    display: block;
    font-size: 15px;
    color: var(--cream-dimmest);
  }

  .download-icon {
    font-size: 20px;
    color: var(--yellow);
  }

  .downloads-todo {
    position: relative;
    margin: 32px 0 0;
  }

  @media (max-width: 860px) {
    .downloads-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }

  /* ----------------------------------------------------------------- faq */
  .faq {
    padding: 0 0 84px;
  }

  .faq-head {
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
    margin: 0 0 8px;
    text-align: center;
  }

  .faq-sub {
    font-size: 18px;
    color: var(--ink-70);
    margin: 0 auto 38px;
    max-width: 52ch;
    text-align: center;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 26px;
  }

  .faq-card {
    background: var(--paper-alt);
    border-radius: 24px;
    padding: 26px 30px;
  }

  .faq-card h3 {
    font-size: 21px;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .faq-card p {
    font-size: 16px;
    color: var(--ink-70);
    margin: 0;
  }

  @media (max-width: 760px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Filters the pre-rendered card grid. Cards stay in the DOM either way.
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  const grid = document.querySelector<HTMLElement>("[data-guide-grid]");
  const noResults = document.querySelector<HTMLElement>("[data-no-results]");

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-category]"));

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        const filter = chip.dataset.filter;

        for (const other of chips) {
          const isActive = other === chip;
          other.classList.toggle("chip--active", isActive);
          other.setAttribute("aria-pressed", String(isActive));
        }

        let visible = 0;

        for (const card of cards) {
          const matches = filter === "all" || card.dataset.category === filter;
          card.hidden = !matches;
          if (matches) visible += 1;
        }

        noResults?.toggleAttribute("hidden", visible > 0);
      });
    }
  }
</script>
