---
import { getCollection } from "astro:content";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import EmailSignupBand from "../../../components/EmailSignupBand.astro";

/*
 * Publishing a new update is now a matter of adding one Markdown file to
 * src/content/updates/ — this list and the post's page both follow from it.
 */
const updates = (
  await getCollection("updates", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  )
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  title="Community Updates"
  description="Recaps, milestones, and the ongoing story of Ramp Up."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Parent Resources &rsaquo; Community Updates</p>
      <h1>The ongoing story.</h1>
      <p class="lede">
        Recaps, milestones, kid wins, and new locations &mdash; the living story
        of a growing movement.
      </p>

      <div class="post-list">
        {
          updates.map((update) => (
            <a class="card post-card" href={`/parent-resources/community-updates/${update.id}`}>
              <time class="date" datetime={update.data.publishedAt.toISOString()}>
                {update.data.publishedAt.toLocaleDateString("en-US", {
                  month: "long",
                  day: "numeric",
                  year: "numeric",
                })}
              </time>
              <h2>{update.data.title}</h2>
              <p>{update.data.excerpt}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <EmailSignupBand />
</BaseLayout>

<style>
  h1 {
    font-size: var(--step-h2-section);
    margin: 0 0 16px;
  }

  .post-list {
    display: grid;
    gap: 20px;
    margin-top: 40px;
  }

  .post-card {
    padding: 30px 34px;
  }

  .date {
    display: block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-50);
    margin-bottom: 8px;
  }

  .post-card h2 {
    font-size: 26px;
    font-weight: 700;
    margin: 0 0 10px;
  }

  .post-card p {
    color: var(--ink-70);
    margin: 0;
  }
</style>
