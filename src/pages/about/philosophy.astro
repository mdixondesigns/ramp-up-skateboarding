---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CheckerboardSection from "../../components/CheckerboardSection.astro";
import ContributionDonut from "../../components/ContributionDonut.astro";
import EmailSignupBand from "../../components/EmailSignupBand.astro";

import {
  contributions,
  contributionPeriod,
  hasContributionFigures,
} from "../../data/contributions";

import resiliencePhoto from "../../assets/photos/rootdown-37.jpg";
import resourcefulnessPhoto from "../../assets/photos/rootdown-54.jpg";
import confidencePhoto from "../../assets/photos/ramp_up-54.jpg";
import expressionPhoto from "../../assets/photos/radnor-144.jpg";

/*
 * Written once and used by both branches below — the chart carries this copy
 * as its own header when there are figures to show, and the fallback section
 * says the same thing above a build-out note when there aren't.
 *
 * TODO(Christine): this is a first draft of the copy. It describes what the
 * four spending categories are, so check it says what you actually do.
 */
const givingCopy = {
  eyebrow: "Engage the community",
  heading: "We're a customer of the scene we serve",
  body: "A program that takes from skateboarding and puts nothing back isn't really part of it. We pay our coaches for their time, buy from the shops down the road rather than online, hire the photographers who shoot our sessions, and give directly to the parks and ramps our kids ride.",
};

const pillars = [
  {
    title: "Resilience",
    body: "Kids fall down learning to skate — a lot. We teach them to get back up, on the board and off it.",
    image: resiliencePhoto,
    imageAlt:
      "A coach holding a young skater's hand as he rolls down a wooden ramp, with other kids watching their turn",
  },
  {
    title: "Resourcefulness",
    body: "Skateboarding rewards figuring things out for yourself. We coach kids toward their own solutions, not just ours.",
    image: resourcefulnessPhoto,
    imageAlt:
      "A coach talking a group of kids through a trick indoors, each of them holding their own board",
  },
  {
    title: "Confidence",
    body: "Every small win — a first push, a first roll-in — compounds into real self-belief.",
    image: confidencePhoto,
    imageAlt:
      "A girl in a tie-dye shirt riding a board with her arms out for balance while a coach walks beside her",
  },
  {
    title: "Creative expression",
    body: "There's no one right way to ride a skateboard. We encourage kids to find their own style.",
    image: expressionPhoto,
    imageAlt:
      "Three young skaters in helmets and pads waiting with their boards at an outdoor skatepark",
  },
];
---

<BaseLayout
  title="Our Philosophy"
  description="Ramp Up's mission and vision for using skateboarding to build resilient, confident kids."
>
  <section>
    <div class="container">
      <p class="eyebrow">About &rsaquo; Our Philosophy</p>
      <h1>Our Mission</h1>
      <p class="lede">
        To build confident, resilient kids by providing a welcoming and
        inclusive entry point to skateboarding for families through
        structured, fun, and safe instruction.
      </p>

      <h2>Our Vision</h2>
      <p class="lede">
        To use skateboarding as a catalyst for building resilience,
        creativity, and confidence &mdash; empowering kids to thrive in our
        ever-changing world.
      </p>
    </div>
  </section>

  <CheckerboardSection
    heading="The four pillars"
    sub="What we are actually teaching, underneath the pushing and the falling."
    rows={pillars}
    background="alt"
  />

  {
    /*
     * The chart only exists once there are real figures. Until then the section
     * keeps its copy and shows a build-out note where the chart goes — the same
     * treatment the Sawyer spots get. What it never does is draw a donut out of
     * stand-in numbers, which would read as a factual claim about money.
     */
    hasContributionFigures ? (
      <ContributionDonut
        id="supporting-the-scene"
        eyebrow={givingCopy.eyebrow}
        heading={givingCopy.heading}
        body={givingCopy.body}
        items={contributions}
        centerLabel="back into the scene"
        note={
          contributionPeriod
            ? `Figures cover ${contributionPeriod}. Shares are rounded to the nearest percent.`
            : undefined
        }
        background="paper"
      />
    ) : (
      <section id="supporting-the-scene">
        <div class="container">
          <p class="eyebrow">{givingCopy.eyebrow}</p>
          <h2>{givingCopy.heading}</h2>
          <p>{givingCopy.body}</p>

          <div class="todo">
            TODO(Christine): the breakdown chart appears here as soon as
            <code>src/data/contributions.ts</code> has real figures in it. It is
            deliberately not drawn with stand-in amounts &mdash; these are public
            claims about money, and a wrong one reads as a fact rather than as an
            obvious placeholder.
          </div>
        </div>
      </section>
    )
  }

  <section>
    <div class="container">
      <h2>Get behind the mission</h2>
      <p>
        Every family who joins the movement is helping us prove that a van,
        a handful of certified coaches, and a lot of belief can change how
        kids meet a hard new skill. We're just getting started.
      </p>
    </div>
  </section>

  <EmailSignupBand
    heading="Join the movement"
    body="Follow the growth story, and be first to know as we open new sessions and locations."
  />
</BaseLayout>
